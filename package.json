{
  "name": "silver-tongue-monorepo",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "tools"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc && tsc -p packages/tui-web && tsc -p packages/world3d",
    "import:zh": "tsx tools/src/import-vocab-pack.ts vendor/vocab-engine/packs/zh content/languages/zh content/learner/en/glosses-zh.ftl",
    "build:course": "tsx tools/src/build-course.ts",
    "bots": "tsx tools/src/bots.ts",
    "audio": "tsx tools/src/audio.ts",
    "build:web": "npm run build -w @silver-tongue/tui-web",
    "play": "tsx packages/tui-node/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
