{
  "name": "silver-tongue-monorepo",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "tools"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc && tsc -p packages/web-common && tsc -p packages/quiet-web",
    "import:zh": "tsx tools/src/import-vocab-pack.ts vendor/vocab-engine/packs/zh content/languages/zh content/learner/en/glosses-zh.ftl",
    "build:course": "tsx tools/src/build-course.ts",
    "bots": "tsx tools/src/bots.ts",
    "learning": "tsx tools/src/learning.ts",
    "report:goal3": "tsx tools/src/goal3.ts",
    "import:syllabus": "tsx tools/src/syllabus.ts",
    "playtest": "tsx tools/src/playtest.ts",
    "audio": "tsx tools/src/audio.ts",
    "build:quiet": "npm run build -w @silver-tongue/quiet-web",
    "build:merchant": "node packages/market-web/build.mjs",
    "audio:merchant": "tsx tools/src/merchant-audio.ts",
    "typecheck:merchant": "tsc -p packages/market-web",
    "typecheck:journey": "tsc -p packages/journey",
    "typecheck:experiment": "npm run typecheck && npm run typecheck:merchant && npm run typecheck:journey",
    "build:experiment": "npm run build:quiet && npm run build:merchant && tsx tools/src/site.ts --lab --merchant",
    "build:site": "npm run build:quiet && tsx tools/src/site.ts",
    "play": "tsx packages/tui-node/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
