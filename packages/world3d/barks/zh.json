      "lines": [
        { "text": "这个面很好吃！", "reading": "Zhège miàn hěn hǎochī!", "gloss": { "en": "These noodles are delicious!", "bn": "এই নুডলস খুব মজার!" }, "clip": "7cfda3944c802db5" },
        { "text": "老板，再来一碗！", "reading": "Lǎobǎn, zài lái yì wǎn!", "gloss": { "en": "Boss, another bowl!", "bn": "মালিক, আরেক বাটি দিন!" }, "clip": "9d9b323fb6be71fd" },
        { "text": "你也来吃面吗？", "reading": "Nǐ yě lái chī miàn ma?", "gloss": { "en": "Are you here for noodles too?", "bn": "আপনিও কি নুডলস খেতে এসেছেন?" }, "clip": "4a03bef8c1e1eb08" }
