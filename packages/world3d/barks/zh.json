      ]
    },
    "cook": {
      "lines": [
        { "text": "欢迎！今天的面很好吃。", "reading": "Huānyíng! Jīntiān de miàn hěn hǎochī.", "gloss": { "en": "Welcome! The noodles are great today.", "bn": "স্বাগতম! আজকের নুডলস খুব মজার।" }, "clip": "339800cab4e1f04f" },
        { "text": "我现在很忙。", "reading": "Wǒ xiànzài hěn máng.", "gloss": { "en": "I'm very busy right now.", "bn": "আমি এখন খুব ব্যস্ত।" }, "clip": "085ce503eb5bc209" }
