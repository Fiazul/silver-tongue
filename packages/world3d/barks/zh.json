        { "text": "你要买水果吗？", "reading": "Nǐ yào mǎi shuǐguǒ ma?", "gloss": { "en": "Would you like some fruit?", "bn": "ফল কিনবে?" }, "clip": "6f754bab8b1d66b4" }
      ]
    },
    "teacher": {
      "lines": [
        { "text": "学习很重要。", "reading": "Xuéxí hěn zhòngyào.", "gloss": { "en": "Studying is important.", "bn": "পড়াশোনা খুব জরুরি।" }, "clip": "d35dac0e8cd0063d" },
