        { "text": "快递！快递！", "reading": "Kuàidì! Kuàidì!", "gloss": { "en": "Delivery! Delivery!", "bn": "ডেলিভারি! ডেলিভারি!" }, "clip": "3e143ce4c0c729c8" }
