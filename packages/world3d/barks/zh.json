    "doctor": {
      "lines": [
        { "text": "多喝水，多休息。", "reading": "Duō hē shuǐ, duō xiūxi.", "gloss": { "en": "Drink plenty of water and rest.", "bn": "বেশি করে পানি খাও, বিশ্রাম নাও।" }, "clip": "0e714de74c4ae037" },
        { "text": "你今天好吗？", "reading": "Nǐ jīntiān hǎo ma?", "gloss": { "en": "Are you well today?", "bn": "আজ তুমি ভালো আছ?" }, "clip": "772084a1bf5052aa" }
      ]
    },
    "traveller": {
      "lines": [
        { "text": "车怎么还没来？", "reading": "Chē zěnme hái méi lái?", "gloss": { "en": "Why hasn't the bus come yet?", "bn": "বাস এখনও আসছে না কেন?" }, "clip": "35e1a54e19112c09" },
        { "text": "我要去北京。", "reading": "Wǒ yào qù Běijīng.", "gloss": { "en": "I'm going to Beijing.", "bn": "আমি বেইজিং যাব।" }, "clip": "4107350b38d34230" }
      ]
    },
    "driver": {
      "lines": [
