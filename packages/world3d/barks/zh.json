        { "text": "中文很难，对吧？", "reading": "Zhōngwén hěn nán, duì ba?", "gloss": { "en": "Chinese is hard, isn't it?", "bn": "চীনা ভাষা কঠিন, তাই না?" }, "clip": "d53627e3fc29e8dd" }
      ]
