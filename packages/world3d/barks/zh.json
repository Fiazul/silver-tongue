        { "text": "上车吗？", "reading": "Shàng chē ma?", "gloss": { "en": "Getting on?", "bn": "উঠবেন?" }, "clip": "4d6b71fcd4e9c957" }
      ]
    },
    "shopkeeper": {
      "lines": [
        { "text": "欢迎光临！", "reading": "Huānyíng guānglín!", "gloss": { "en": "Welcome!", "bn": "স্বাগতম!" }, "clip": "c1cbe543632964e1" },
        { "text": "今天人不多。", "reading": "Jīntiān rén bù duō.", "gloss": { "en": "Not many people today.", "bn": "আজ লোকজন বেশি নেই।" }, "clip": "272799e6b013c25d" }
      ]
    },
    "teaboss": {
      "lines": [
        { "text": "喝茶吗？", "reading": "Hē chá ma?", "gloss": { "en": "Some tea?", "bn": "চা খাবেন?" }, "clip": "818b4b267b7581bc" },
        { "text": "慢慢喝，别着急。", "reading": "Mànmàn hē, bié zháojí.", "gloss": { "en": "Drink slowly, no hurry.", "bn": "আস্তে আস্তে খান, তাড়া নেই।" }, "clip": "a5c7a94dbc8cabdb" }
      ]
