      "voice": "zh-CN-XiaoyiNeural",
      "lines": [
        { "text": "你吃饭了吗？", "reading": "Nǐ chīfàn le ma?", "gloss": { "en": "Have you eaten?", "bn": "তুমি খেয়েছ?" }, "clip": "4dd0e03270557acc" },
        { "text": "慢慢走，别着急。", "reading": "Mànmàn zǒu, bié zháojí.", "gloss": { "en": "Take it slowly, no hurry.", "bn": "আস্তে হাঁটো, তাড়াহুড়ো কোরো না।" }, "clip": "d3815de23843d66d" },
        { "text": "你的中文不错！", "reading": "Nǐ de Zhōngwén búcuò!", "gloss": { "en": "Your Chinese is pretty good!", "bn": "তোমার চীনা ভাষা বেশ ভালো!" }, "clip": "4313246b93fab6de" }
      ]
    },
    "tourist": {
      "voice": "zh-CN-XiaoyiNeural",
      "lines": [
