        { "text": "请坐，喝杯茶吧。", "reading": "Qǐng zuò, hē bēi chá ba.", "gloss": { "en": "Sit down, have a cup of tea.", "bn": "বসুন, এক কাপ চা খান।" }, "clip": "bae8c975755fe187" }
      ]
