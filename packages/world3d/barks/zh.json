    "egg_seller": {
      "voice": "zh-CN-YunyangNeural",
      "lines": [
        { "text": "今天没有鸡蛋。", "reading": "Jīntiān méiyǒu jīdàn.", "gloss": { "en": "No eggs today.", "bn": "আজ ডিম নেই।" }, "clip": "e4e9b1c167bc1a50" },
        { "text": "明天来吧，明天有。", "reading": "Míngtiān lái ba, míngtiān yǒu.", "gloss": { "en": "Come tomorrow, there'll be some tomorrow.", "bn": "কাল আসুন, কাল থাকবে।" }, "clip": "b5507e047e3afce9" },
        { "text": "不好意思，鸡蛋都卖完了。", "reading": "Bù hǎoyìsi, jīdàn dōu mài wán le.", "gloss": { "en": "Sorry, the eggs are all sold out.", "bn": "দুঃখিত, সব ডিম বিক্রি হয়ে গেছে।" }, "clip": "2f2e72320908d2d7" }
      ]
    },
    "stroller": {
      "voice": "zh-CN-XiaoxiaoNeural",
      "lines": [
        { "text": "今天天气很好！", "reading": "Jīntiān tiānqì hěn hǎo!", "gloss": { "en": "The weather is lovely today!", "bn": "আজ আবহাওয়া খুব ভালো!" }, "clip": "35119a3242c4edac" },
        { "text": "我喜欢在河边走。", "reading": "Wǒ xǐhuan zài hébiān zǒu.", "gloss": { "en": "I like walking by the river.", "bn": "আমি নদীর ধারে হাঁটতে ভালোবাসি।" }, "clip": "a02ee0321790c845" }
      ]
    },
    "shopper": {
      "voice": "zh-CN-YunyangNeural",
      "lines": [
        { "text": "我去买菜。", "reading": "Wǒ qù mǎi cài.", "gloss": { "en": "I'm off to buy groceries.", "bn": "আমি বাজার করতে যাচ্ছি।" }, "clip": "178e92bcbdeae340" },
        { "text": "水果太贵了！", "reading": "Shuǐguǒ tài guì le!", "gloss": { "en": "Fruit is too expensive!", "bn": "ফলের দাম খুব বেশি!" }, "clip": "521fcc21f1039b01" },
        { "text": "你也去市场吗？", "reading": "Nǐ yě qù shìchǎng ma?", "gloss": { "en": "Are you going to the market too?", "bn": "আপনিও কি বাজারে যাচ্ছেন?" }, "clip": "e76917526d503e69" }
      ]
    },
    "worker": {
      "voice": "zh-CN-YunxiaNeural",
      "lines": [
        { "text": "我要去上班。", "reading": "Wǒ yào qù shàngbān.", "gloss": { "en": "I have to get to work.", "bn": "আমাকে কাজে যেতে হবে।" }, "clip": "a027530e03894d35" },
        { "text": "对不起，我没有时间。", "reading": "Duìbuqǐ, wǒ méiyǒu shíjiān.", "gloss": { "en": "Sorry, I don't have time.", "bn": "দুঃখিত, আমার সময় নেই।" }, "clip": "dc35628650b6dc42" }
      ]
    },
    "kid": {
      "voice": "zh-CN-YunxiaNeural",
      "lines": [
        { "text": "你好！你是哪国人？", "reading": "Nǐ hǎo! Nǐ shì nǎ guó rén?", "gloss": { "en": "Hi! Which country are you from?", "bn": "হ্যালো! তুমি কোন দেশের মানুষ?" }, "clip": "fd98906e407bcaaa" },
        { "text": "我八岁了！", "reading": "Wǒ bā suì le!", "gloss": { "en": "I'm eight!", "bn": "আমার আট বছর!" }, "clip": "c703a6dad89237c2" },
        { "text": "我们一起玩吧！", "reading": "Wǒmen yìqǐ wán ba!", "gloss": { "en": "Let's play together!", "bn": "চলো একসাথে খেলি!" }, "clip": "3aeef7bcc8009368" }
      ]
    },
