    "wang": {
      "lines": [
        { "text": "你好！今天学习了吗？", "reading": "Nǐ hǎo! Jīntiān xuéxí le ma?", "gloss": { "en": "Hello! Have you studied today?", "bn": "নমস্কার! আজ পড়াশোনা করেছ?" }, "clip": "f4af7936d756fea3" },
