    "cat": {
      "voice": "zh-CN-XiaoyiNeural",
      "lines": [
        { "text": "喵。", "reading": "Miāo.", "gloss": { "en": "Meow.", "bn": "মিয়াঁও।" }, "clip": "3d6eec7a77492983" },
        { "text": "喵喵！", "reading": "Miāo miāo!", "gloss": { "en": "Meow meow!", "bn": "মিয়াঁও মিয়াঁও!" }, "clip": "93eda6ff82385ecb" }
