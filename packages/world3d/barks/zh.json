      "lines": [
        { "text": "别忘了房租。", "reading": "Bié wàng le fángzū.", "gloss": { "en": "Don't forget the rent.", "bn": "ভাড়ার কথা ভুলো না।" }, "clip": "9aed32abad72b903" },
        { "text": "晚上早点儿睡。", "reading": "Wǎnshang zǎo diǎnr shuì.", "gloss": { "en": "Get to bed early tonight.", "bn": "রাতে তাড়াতাড়ি ঘুমিও।" }, "clip": "dde03b549dafcf86" }
